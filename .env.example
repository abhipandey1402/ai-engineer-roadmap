SANDBOX_ENABLED=false
PLAYGROUND_SESSION_SECRET=replace-with-at-least-32-random-characters
PLAYGROUND_ACCESS_TOKEN=replace-with-a-private-owner-access-token
PLAYGROUND_ALLOW_BYOK=false

# Optional static Vercel Sandbox authentication when OIDC is unavailable.
# Set all three together. Leave them blank when using OIDC.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
